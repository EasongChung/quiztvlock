<?xml version="1.0" encoding="utf-8"?>
<!-- 家长设置页：电视端用遥控器操作，每项为「点击循环切换数值」的按钮 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101820">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#FFC107"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="家长设置（遥控器点击切换数值）"
            android:textColor="#9FB3C8"
            android:textSize="14sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/statusView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#8FD14F"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnWatchMinutes"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:textSize="16sp"
            android:background="@drawable/btn_option"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnPerCorrect"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:textSize="16sp"
            android:background="@drawable/btn_option"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnPerRound"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:textSize="16sp"
            android:background="@drawable/btn_option"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnExtraWrong"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:textSize="16sp"
            android:background="@drawable/btn_option"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="开始守护计时"
            android:textSize="18sp"
            android:textColor="#0B6E4F"
            android:background="@drawable/btn_option"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnTestLock"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="立即进入答题（测试）"
            android:textSize="16sp"
            android:textColor="#B71C1C"
            android:background="@drawable/btn_option"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/webuiTips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#9FB3C8"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp" />

    </LinearLayout>
</ScrollView>
